class Solution:
    def maximumLengthSubstring(self, s: str) -> int:
        freq = [0] * 26
        left = 0
        ans = 0
        
        for right, ch in enumerate(s):
            idx = ord(ch) - ord('a')
            freq[idx] += 1
            while freq[idx] > 2:
                freq[ord(s[left]) - ord('a')] -= 1
                left += 1
            ans = max(ans, right - left + 1)
        
        return ans

'''
Approach:
1. Use a sliding window with two pointers, `left` and `right`, and a frequency array 
   to track character counts within the window.
2. Expand the window by advancing `right` and incrementing the count of `s[right]`.
3. If the count of the newly added character exceeds 2, shrink the window from the 
   left by decrementing counts and advancing `left` until all characters in the window 
   appear at most twice.
4. After ensuring the window is valid, update the maximum length found.
5. Return the maximum length.

Time Complexity: O(N), where N is the length of s.
Space Complexity: O(1).
'''
