class Solution:
    def firstStableIndex(self, nums: list[int], k: int) -> int:
        n = len(nums)
        
        for i in range(n):
            prefix_max = max(nums[:i + 1])
            suffix_min = min(nums[i:])
            if prefix_max - suffix_min <= k:
                return i
        
        return -1

'''
Approach:
1. Iterate through each index i from 0 to n-1.
2. For each i, compute the maximum value in the prefix nums[0..i] and the minimum 
   value in the suffix nums[i..n-1].
3. Calculate the instability score as the difference between these two values.
4. If the score is less than or equal to k, return i immediately as the smallest 
   stable index.
5. If no index satisfies the condition, return -1.

Time Complexity: O(N^2), where N is the length of nums.
Space Complexity: O(1).
'''
