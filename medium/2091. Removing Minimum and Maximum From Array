from typing import List

class Solution:
    def minimumDeletions(self, nums: List[int]) -> int:
        n = len(nums)
        min_idx = 0
        max_idx = 0
        
        # Find indices of the minimum and maximum elements
        for i in range(1, n):
            if nums[i] < nums[min_idx]:
                min_idx = i
            if nums[i] > nums[max_idx]:
                max_idx = i
        
        # Ensure min_idx <= max_idx
        if min_idx > max_idx:
            min_idx, max_idx = max_idx, min_idx
        
        # Strategy 1: Delete from the front up to and including max_idx
        left_only = max_idx + 1
        
        # Strategy 2: Delete from min_idx to the end
        right_only = n - min_idx
        
        # Strategy 3: Delete from both sides
        both_sides = (min_idx + 1) + (n - max_idx)
        
        return min(left_only, right_only, both_sides)

'''
Approach:
1. Find the indices of the minimum and maximum elements in the array.
2. Ensure the minimum index is not greater than the maximum index by swapping if needed.
3. Consider three strategies to remove both elements using only front and back deletions:
   - Remove from the left only, deleting everything up to and including the rightmost target.
   - Remove from the right only, deleting everything from the leftmost target to the end.
   - Remove from both sides, deleting up to the leftmost target from the front and from the rightmost target to the end from the back.
4. Return the minimum deletions among the three strategies.

Time Complexity: O(N), where N is the length of nums.
Space Complexity: O(1).
'''
