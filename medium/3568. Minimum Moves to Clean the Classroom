from collections import deque
from typing import List

class Solution:
    def minMoves(self, classroom: List[str], energy: int) -> int:
        m = len(classroom)
        n = len(classroom[0])
        
        # Locate the starting position and all litter cells
        start_r = start_c = 0
        litter_id = {}
        lid = 0
        for i in range(m):
            for j in range(n):
                if classroom[i][j] == 'S':
                    start_r, start_c = i, j
                elif classroom[i][j] == 'L':
                    litter_id[(i, j)] = lid
                    lid += 1
        
        L = lid
        if L == 0:
            return 0
        
        full_mask = (1 << L) - 1
        max_e = energy
        dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]
        
        # Flattened visited array: visited[r][c][e][mask] encoded in a bytearray
        total_states = m * n * (max_e + 1) * (1 << L)
        visited = bytearray(total_states)
        
        def get_idx(r, c, e, mask):
            return ((r * n + c) * (max_e + 1) + e) * (1 << L) + mask
        
        q = deque()
        start_mask = 0
        q.append((start_r, start_c, max_e, start_mask, 0))
        visited[get_idx(start_r, start_c, max_e, start_mask)] = 1
        
        while q:
            r, c, e, mask, moves = q.popleft()
            
            for dr, dc in dirs:
                nr, nc = r + dr, c + dc
                if not (0 <= nr < m and 0 <= nc < n):
                    continue
                if classroom[nr][nc] == 'X':
                    continue
                if e <= 0:
                    continue
                
                ne = e - 1
                nmask = mask
                cell = classroom[nr][nc]
                
                if cell == 'R':
                    ne = max_e
                elif cell == 'L' and (nr, nc) in litter_id:
                    nmask |= (1 << litter_id[(nr, nc)])
                
                if nmask == full_mask:
                    return moves + 1
                
                idx = get_idx(nr, nc, ne, nmask)
                if not visited[idx]:
                    visited[idx] = 1
                    q.append((nr, nc, ne, nmask, moves + 1))
        
        return -1

'''
Approach:
1. Identify the starting position 'S' and assign each 'L' cell a unique bit index.
2. Use BFS over the state space (row, col, current_energy, collected_mask). The 
   state space size is at most 20 * 20 * 51 * 1024 ≈ 21M, which fits in a bytearray.
3. From each state, attempt to move to the four adjacent cells. A move is valid if:
   - The target cell is within bounds and not an obstacle 'X'.
   - The current energy is at least 1.
4. After moving, decrement energy by 1. If the new cell is 'R', reset energy to 
   full capacity. If the new cell is 'L', update the collected mask.
5. If the mask indicates all litter has been collected, return the current move 
   count + 1.
6. If the queue is exhausted without collecting all litter, return -1.

Time Complexity: O(m * n * energy * 2^L), where L is the number of litter cells.
Space Complexity: O(m * n * energy * 2^L).
'''
