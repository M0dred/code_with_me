from typing import List

class Solution:
    def longestSubsequence(self, nums: List[int]) -> int:
        total = 0
        has_non_zero = False
        
        for x in nums:
            total ^= x
            if x != 0:
                has_non_zero = True
        
        n = len(nums)
        if total != 0:
            return n
        elif has_non_zero:
            return n - 1
        else:
            return 0

'''
Approach:
1. Compute the XOR of all elements in `nums`.
2. If the total XOR is non-zero, the entire array itself forms a valid subsequence 
   of length n.
3. If the total XOR is zero, the full array cannot be used. However, removing any 
   element `x` leaves a subsequence with XOR equal to `x`. If there exists any 
   non-zero element, we can exclude it to obtain a valid subsequence of length n-1.
4. If all elements are zero, every subsequence has XOR zero, so no valid subsequence 
   exists and the answer is 0.

Time Complexity: O(N), where N is the length of nums.
Space Complexity: O(1).
'''
