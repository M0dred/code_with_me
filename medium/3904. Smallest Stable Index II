class Solution:
    def firstStableIndex(self, nums: list[int], k: int) -> int:
        n = len(nums)
        
        # prefix_max[i] = maximum value in nums[0..i]
        prefix_max = [0] * n
        prefix_max[0] = nums[0]
        for i in range(1, n):
            prefix_max[i] = max(prefix_max[i - 1], nums[i])
        
        # suffix_min[i] = minimum value in nums[i..n-1]
        suffix_min = [0] * n
        suffix_min[n - 1] = nums[n - 1]
        for i in range(n - 2, -1, -1):
            suffix_min[i] = min(suffix_min[i + 1], nums[i])
        
        # Find the smallest stable index
        for i in range(n):
            if prefix_max[i] - suffix_min[i] <= k:
                return i
        
        return -1

'''
Approach:
1. Precompute `prefix_max[i]`, the maximum value in the subarray nums[0..i], by 
   scanning left to right.
2. Precompute `suffix_min[i]`, the minimum value in the subarray nums[i..n-1], by 
   scanning right to left.
3. Iterate through each index i and check if prefix_max[i] - suffix_min[i] <= k.
4. Return the first index satisfying the condition; if none exists, return -1.

Time Complexity: O(N), where N is the length of nums.
Space Complexity: O(N).
'''
